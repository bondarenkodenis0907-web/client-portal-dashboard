    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "node scripts/local-tests.mjs browser",
    "test:local": "node scripts/local-tests.mjs all",
    "test:local:start": "node scripts/local-tests.mjs start",
    "test:local:verify": "node scripts/local-tests.mjs verify",
    "test:local:sql": "node scripts/local-tests.mjs sql",
    "test:local:reset": "node scripts/local-tests.mjs reset",
    "test:local:stop": "node scripts/local-tests.mjs stop",
    "test:local:safety": "node --test tests/local-test-safety.test.mjs",
    "test:deployment-guard": "node --test tests/deployment-guard.test.mjs",
    "test:preview-guard": "node scripts/verify-preview-guard.mjs",
    "test:deployment-hosts": "node --test tests/deployment-hosts.test.mjs",
    "check:preview-hosts": "node scripts/probe-preview-hosts.mjs",
    "test:recovery-policy": "node --test tests/recovery-policy.test.mjs tests/recovery-actions.test.mjs tests/recovery-grant.test.mjs tests/recovery-logout.test.mjs",
    "test:request-submission": "node --test tests/request-submission.test.mjs",
    "test:backup-safety": "node --test tests/backup-safety.test.mjs tests/restore-preflight.test.mjs",
    "test:restore": "node scripts/restore-drill.mjs drill",
    "test:restore:stop": "node scripts/restore-drill.mjs stop",
    "check:backup": "node scripts/restore-drill.mjs verify-backup",
